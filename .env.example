SECRET_KEY=change-me-in-production

# Local (non-Docker): sqlite:///./labgemma.db
# Docker Compose sets: sqlite:////data/labgemma.db
DATABASE_URL=sqlite:///./labgemma.db

# Ollama Cloud — Gemma 4
GEMMA_API_KEY=
GEMMA_API_BASE_URL=https://ollama.com/v1
GEMMA_MODEL=gemma4:31b-cloud

# Set to 1 for offline demo without API calls
MOCK_GEMMA=0

# Docker only: seed demo teacher/student accounts on start (1=yes)
SEED_DEMO=1

# Host port when using docker compose (maps to container 8000)
PORT=8000
